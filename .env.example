DATABASE_URL=
DIRECT_URL=
JWT_SECRET=
PORT=5000
CORS_ORIGIN=*
NODE_ENV=development

# Server-side only. Never expose this key in frontend environment variables.
OPENAI_API_KEY=
AI_MODEL=gpt-5-nano
PERMISSION_DEBUG=false

RESEND_API_KEY=
EMAIL_FROM=
APP_WEB_URL=
EMAIL_VERIFICATION_TTL_MINUTES=60
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# Required only when running prisma db seed. Use non-production credentials.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
