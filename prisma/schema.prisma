generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AccountRole {
  USER
  ADMIN
}

enum ShopProductAssetKind {
  ITEM
  EQUIPMENT
  COINS
}

enum PaymentOrderStatus {
  PENDING
  PAID
  FULFILLED
  FAILED
  CANCELED
}

enum GameplayDifficulty {
  EASY
  MEDIUM
  HARD
  ELITE
}

enum MissionSessionStatus {
  IN_PROGRESS
  READY_TO_TURN_IN
  COMPLETED
  FAILED
  ABANDONED
}

enum CombatSessionStatus {
  IN_PROGRESS
  VICTORY
  DEFEAT
  ESCAPED
}

enum CombatSourceType {
  BOUNTY_HUNT
  MISSION
}

enum CharacterStatus {
  READY
  WOUNDED
  DEFEATED
}

enum CharacterSheetStatus {
  DRAFT
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
}

enum CharacterReviewAction {
  CHANGES_REQUESTED
  APPROVED
}

enum TradeStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELED
  EXPIRED
}

enum TradeParticipantSide {
  REQUESTER
  TARGET
}

enum TradeAssetType {
  ITEM
  EQUIPMENT
}

enum TableMemberRole {
  MASTER
  PLAYER
}

enum TableMemberStatus {
  ACTIVE
  REMOVED
}

enum TableStatus {
  DRAFT
  RECRUITING
  PREPARED
  IN_SESSION
  CLOSED
}

enum TableInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum CharacterReviewStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_CHANGES
}

enum CharacterTraitType {
  POSITIVE
  NEGATIVE
  NEUTRAL
}

enum CharacterTraitSuggestionSource {
  AI
  MASTER
}

enum CharacterTraitSuggestionStatus {
  SUGGESTED
  APPLIED
  DISMISSED
}

enum TableMissionStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum TableMissionSubmissionStatus {
  SUBMITTED
  APPROVED
  REJECTED
  NEEDS_CHANGES
}

enum TableTimelineEventType {
  STORY
  MISSION_CREATED
  MISSION_APPROVED
  CHARACTER_APPROVED
  REWARD
  MASTER_NOTE
  SESSION_SUMMARY
}

enum ContextLayer {
  SETTING
  EPISODE
  PLAYTEST_VALIDATION
}

enum ContextClassification {
  OFFICIAL_CANON
  PUBLIC_CANON
  SECRET_CANON
  TABLE_CANON
  PRODUCT_DECISION
  RULE
  HYPOTHESIS
  PENDING_DECISION
  OUT_OF_MVP
}

enum ContextVisibility {
  PUBLIC
  SPECTATOR
  AUTHENTICATED_TABLE_PLAYER
  SPECIFIC_CHARACTER
  TABLE_MASTER
  AUTHOR_ADMIN
}

enum ContextVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PublicCampaignStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum ParticipantConsentStatus {
  ACCEPTED
  DECLINED
  REVOKED
}

enum PlayerAiSuggestionStatus {
  GENERATED
  ACCEPTED
  EDITED
  DISCARDED
}

enum AiUseCase {
  WORLD_SUMMARY
  MISSION_IDEAS
  TRAIT_SUGGESTIONS
  TIMELINE_SUMMARY
  PLAYER_CHARACTER_CREATION
  PLAYER_CHARACTER_VALIDATION
  CHARACTER_CHAPTER_SUGGESTION
  CHARACTER_FIELD_REFINEMENT
  CHARACTER_CARD_ART_PROMPT
  CHARACTER_CARD_ART_GENERATION
}

enum AiUsageStatus {
  SUCCESS
  ERROR
}

enum AiPricingModality {
  TEXT
  IMAGE
}

enum AiCostSource {
  CONFIGURED_PRICE
  UNPRICED
  USAGE_UNAVAILABLE
}

enum GuardianAvatarKey {
  guardian_sword
  guardian_fist
  guardian_explorer
}

enum AuthSessionRevokeReason {
  LOGOUT
  REFRESH_TOKEN_REUSED
  SESSION_EXPIRED
  ACCOUNT_ROLE_CHANGED
  MEMBERSHIP_CHANGED
  USER_DELETED
  PASSWORD_CHANGED
  SECURITY
}

model User {
  id                      String                   @id @default(uuid())
  nome                    String
  email                   String                   @unique
  senha                   String
  emailVerifiedAt         DateTime?
  accountRole             AccountRole              @default(USER)
  theme                   String?
  selectedGuardianAvatar  GuardianAvatarKey?
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens      PasswordResetToken[]
  characters              Character[]              @relation("UserToCharacter")
  paymentOrders           PaymentOrder[]
  masteredTables          Table[]                  @relation("TableMaster")
  tableMembers            TableMember[]
  createdCharacterTraits  CharacterTrait[]         @relation("CharacterTraitCreator")
  createdTableMissions    TableMission[]           @relation("TableMissionCreator")
  tableMissionSubmissions TableMissionSubmission[]
  tableTimelineEvents     TableTimelineEvent[]     @relation("TableTimelineEventCreator")
  createdTraitSuggestions CharacterTraitSuggestion[] @relation("CharacterTraitSuggestionCreator")
  createdSettings         Setting[]                  @relation("SettingCreator")
  updatedSettings         Setting[]                  @relation("SettingUpdater")
  createdEpisodes         Episode[]                  @relation("EpisodeCreator")
  updatedEpisodes         Episode[]                  @relation("EpisodeUpdater")
  createdContextVersions  ContextVersion[]           @relation("ContextVersionCreator")
  updatedContextVersions  ContextVersion[]           @relation("ContextVersionUpdater")
  approvedContextVersions ContextVersion[]           @relation("ContextVersionApprover")
  createdContextUnits     ContextUnit[]              @relation("ContextUnitCreator")
  updatedContextUnits     ContextUnit[]              @relation("ContextUnitUpdater")
  sentTableInvitations    TableInvitation[]          @relation("TableInvitationInviter")
  acceptedTableInvitations TableInvitation[]         @relation("TableInvitationAccepter")
  approvedCharacters      Character[]                @relation("CharacterSheetApprover")
  characterReviewEvents   CharacterReviewEvent[]     @relation("CharacterReviewEventReviewer")
  submittedCharacterSnapshots CharacterSubmissionSnapshot[] @relation("CharacterSubmissionSnapshotSubmitter")
  approvedCharacterSnapshots  CharacterSubmissionSnapshot[] @relation("CharacterSubmissionSnapshotApprover")
  createdPublicCampaigns  PublicCampaign[]           @relation("PublicCampaignCreator")
  updatedPublicCampaigns  PublicCampaign[]           @relation("PublicCampaignUpdater")
  participantConsents     ParticipantConsent[]        @relation("ParticipantConsentUser")
  playerAiSuggestions     PlayerAiSuggestion[]        @relation("PlayerAiSuggestionUser")
  aiUsageEvents           AiUsageEvent[]              @relation("AiUsageEventUser")
  finalSurveyResponses    FinalSurveyResponse[]       @relation("FinalSurveyResponseUser")
  analyticsEvents         AnalyticsEvent[]            @relation("AnalyticsEventUser")
  characterLegacyAdaptations CharacterLegacyAdaptation[] @relation("CharacterLegacyAdaptationAdmin")
  characterCardArtGenerations CharacterCardArtGeneration[]
  authSessions             AuthSession[]
}

model AuthSession {
  id            String                   @id @default(uuid())
  userId        String
  familyId      String                   @unique @default(uuid())
  createdAt     DateTime                 @default(now())
  expiresAt     DateTime
  lastUsedAt    DateTime?
  revokedAt     DateTime?
  revokeReason  AuthSessionRevokeReason?

  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens AuthRefreshToken[]

  @@index([userId, revokedAt, expiresAt])
  @@index([familyId, revokedAt])
}

model AuthRefreshToken {
  id                String            @id @default(uuid())
  sessionId         String
  tokenHash         String            @unique
  createdAt         DateTime          @default(now())
  expiresAt         DateTime
  consumedAt        DateTime?
  replacedByTokenId String?           @unique

  session           AuthSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  replacedBy        AuthRefreshToken?  @relation("AuthRefreshRotation", fields: [replacedByTokenId], references: [id], onDelete: SetNull)
  replaces          AuthRefreshToken?  @relation("AuthRefreshRotation")

  @@index([sessionId, createdAt])
  @@index([sessionId, consumedAt, expiresAt])
}

model EmailVerificationToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt, expiresAt])
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt, expiresAt])
}

model Setting {
  id          String   @id @default(uuid())
  stableKey   String   @unique
  title       String
  description String?
  createdById String
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy       User             @relation("SettingCreator", fields: [createdById], references: [id])
  updatedBy       User?            @relation("SettingUpdater", fields: [updatedById], references: [id])
  episodes        Episode[]
  contextVersions ContextVersion[]
  tables          Table[]

  @@index([createdAt])
}

model Episode {
  id          String   @id @default(uuid())
  settingId   String
  stableKey   String
  title       String
  synopsis    String?
  createdById String
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  setting         Setting          @relation(fields: [settingId], references: [id], onDelete: Restrict)
  createdBy       User             @relation("EpisodeCreator", fields: [createdById], references: [id])
  updatedBy       User?            @relation("EpisodeUpdater", fields: [updatedById], references: [id])
  contextVersions ContextVersion[]
  tables          Table[]

  @@unique([settingId, stableKey])
  @@index([settingId, createdAt])
}

model ContextVersion {
  id           String               @id @default(uuid())
  settingId    String
  episodeId    String?
  layer        ContextLayer
  version      Int
  status       ContextVersionStatus @default(DRAFT)
  origin       String
  approvalNote String
  createdById  String
  updatedById  String?
  approvedById String?
  publishedAt  DateTime?
  archivedAt   DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  setting    Setting       @relation(fields: [settingId], references: [id], onDelete: Restrict)
  episode    Episode?      @relation(fields: [episodeId], references: [id], onDelete: Restrict)
  createdBy  User          @relation("ContextVersionCreator", fields: [createdById], references: [id])
  updatedBy  User?         @relation("ContextVersionUpdater", fields: [updatedById], references: [id])
  approvedBy User?         @relation("ContextVersionApprover", fields: [approvedById], references: [id])
  units      ContextUnit[]
  tables     Table[]
  characterSubmissionSnapshots CharacterSubmissionSnapshot[]
  playerAiSuggestions PlayerAiSuggestion[]

  @@unique([settingId, episodeId, layer, version])
  @@index([settingId, episodeId, layer, status, version])
}

model ContextUnit {
  id               String                @id @default(uuid())
  contextVersionId String
  classification   ContextClassification
  visibility       ContextVisibility
  title            String
  content          String
  sortOrder        Int                   @default(0)
  createdById      String
  updatedById      String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  contextVersion ContextVersion @relation(fields: [contextVersionId], references: [id], onDelete: Cascade)
  createdBy      User           @relation("ContextUnitCreator", fields: [createdById], references: [id])
  updatedBy      User?          @relation("ContextUnitUpdater", fields: [updatedById], references: [id])

  @@index([contextVersionId, visibility, classification])
}

model Character {
  id              String          @id @default(uuid())
  userId          String
  name            String
  concept         String?
  origin          String?
  appearance      String?
  desire          String?
  fear            String?
  promiseOrGuilt  String?
  reasonToActWithGroup String?
  markLocation    String?
  markAppearance  String?
  markReaction    String?
  markAttitude    String?
  archetypeKey    String?
  attributes      Json?
  trainings       Json?
  positiveTrait   Json?
  negativeTrait   Json?
  narrativeBond   String?
  personalHistory String?
  initialEquipment Json?
  creativeDossier Json?
  builderConfigVersion String              @default("pilot-v1")
  narrativeResponses Json?
  confirmedNarrativeContext Json?
  playStylePreference String?
  sheetStatus     CharacterSheetStatus @default(DRAFT)
  sheetRevision   Int                  @default(1)
  submittedRevision Int?
  submittedAt     DateTime?
  approvedAt      DateTime?
  approvedById    String?
  level           Int             @default(1)
  xp              Int             @default(0)
  pvpRating       Int             @default(1000)
  pvpWins         Int             @default(0)
  pvpLosses       Int             @default(0)
  lastPvpAt       DateTime?
  currentHealth   Int             @default(100)
  status          CharacterStatus @default(READY)
  lastCheckpoint  String?
  lastCombatAt    DateTime?
  lastRecoveredAt DateTime?
  avatarId        String?
  titleId         String?
  bannerId        String?
  tableId         String?
  posX            Float?
  posY            Float?
  posZ            Float?
  inventoryId     String?         @unique
  classId         String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user                    User                      @relation("UserToCharacter", fields: [userId], references: [id])
  approvedBy              User?                     @relation("CharacterSheetApprover", fields: [approvedById], references: [id])
  table                   Table?                    @relation(fields: [tableId], references: [id])
  inventory               Inventory?                @relation(fields: [inventoryId], references: [id])
  class                   Class                     @relation("ClassToCharacter", fields: [classId], references: [id])
  transactions            Transaction[]
  actionLogs              CharacterActionLog[]
  paymentOrders           PaymentOrder[]
  rewardClaims            RewardClaim[]
  missionSessions         CharacterMissionSession[]
  combatSessions          CombatSession[]
  sentTrades              Trade[]                   @relation("TradeRequesterCharacter")
  receivedTrades          Trade[]                   @relation("TradeTargetCharacter")
  pvpMatchesAsChallenger  PvpMatch[]                @relation("PvpMatchChallenger")
  pvpMatchesAsOpponent    PvpMatch[]                @relation("PvpMatchOpponent")
  pvpWinsAsWinner         PvpMatch[]                @relation("PvpMatchWinner")
  pvpLossesAsLoser        PvpMatch[]                @relation("PvpMatchLoser")
  reviews                 CharacterReview[]
  episodeAnswers          CharacterEpisodeAnswer[]
  submissionSnapshots     CharacterSubmissionSnapshot[]
  reviewEvents            CharacterReviewEvent[]
  traits                  CharacterTrait[]
  traitSuggestions        CharacterTraitSuggestion[]
  playerAiSuggestions     PlayerAiSuggestion[]
  aiUsageEvents           AiUsageEvent[]
  analyticsEvents         AnalyticsEvent[]
  legacyAdaptation        CharacterLegacyAdaptation?
  tableMissionSubmissions TableMissionSubmission[]
  timelineEvents          TableTimelineEvent[]
  cardArtGenerations      CharacterCardArtGeneration[]

  @@index([tableId, createdAt])
  @@index([tableId, userId, sheetStatus, createdAt])
  @@index([approvedById])
}

model Inventory {
  id          String      @id @default(uuid())
  coins       Int         @default(0)
  items       Item[]
  equipments  Equipment[]
  character   Character?
  characterId String?     @unique
}

model Item {
  id               String  @id @default(uuid())
  name             String
  value            Int
  category         String
  type             String
  img              String
  effect           String?
  levelRequirement Int?
  quantity         Int     @default(1)
  inventoryId      String
  monsterId        String?

  inventory Inventory @relation(fields: [inventoryId], references: [id])
  monster   Monster?  @relation
}

model Equipment {
  id               String    @id @default(uuid())
  name             String
  value            Int
  category         String
  type             String
  img              String
  effect           String?
  levelRequirement Int?
  isEquipped       Boolean   @default(false)
  equippedAt       DateTime?
  inventoryId      String

  inventory Inventory @relation(fields: [inventoryId], references: [id])
}

model Class {
  id          String      @id @default(uuid())
  name        String      @unique
  tier        Int         @default(1)
  evolvesFrom String?
  modifier    String
  description String
  passive     String?
  characters  Character[] @relation("ClassToCharacter")
}

model BountyHunt {
  id                 String             @id @default(uuid())
  title              String
  description        String?
  monsterId          String
  recommendedLevel   Int                @default(1)
  difficulty         GameplayDifficulty @default(EASY)
  reward             Int
  rewardXp           Int                @default(0)
  rewardItemName     String?
  rewardItemCategory String?
  rewardItemType     String?
  rewardItemImg      String?
  rewardItemEffect   String?
  rewardItemValue    Int?
  rewardItemQuantity Int                @default(1)
  timeLimit          DateTime
  status             String
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  monster Monster @relation(fields: [monsterId], references: [id])
}

model Monster {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  imageUrl    String?
  level       Int
  health      Int
  attack      Int
  defense     Int
  experience  Int
  dropItemId  String? @unique

  dropItem Item?        @relation(fields: [dropItemId], references: [id])
  bounties BountyHunt[]
}

model MissionDefinition {
  id                    String             @id @default(uuid())
  title                 String
  description           String?
  difficulty            GameplayDifficulty @default(EASY)
  recommendedLevel      Int                @default(1)
  imageUrl              String?
  startNpcId            String?
  completionNpcId       String?
  startDialogue         String?
  completionDialogue    String?
  repeatCooldownSeconds Int                @default(1800)
  journey               Json?
  enemyName             String
  enemyLevel            Int
  enemyHealth           Int
  enemyAttack           Int
  enemyDefense          Int
  rewardXp              Int
  rewardCoins           Int
  rewardItemName        String?
  rewardItemCategory    String?
  rewardItemType        String?
  rewardItemImg         String?
  rewardItemEffect      String?
  rewardItemValue       Int?
  rewardItemQuantity    Int                @default(1)
  isActive              Boolean            @default(true)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  startNpc      NpcDefinition?            @relation("MissionStartNpc", fields: [startNpcId], references: [id])
  completionNpc NpcDefinition?            @relation("MissionCompletionNpc", fields: [completionNpcId], references: [id])
  sessions      CharacterMissionSession[]
}

model TrainingDefinition {
  id              String   @id @default(uuid())
  name            String
  description     String?
  trainingType    String
  xpReward        Int
  coinsReward     Int      @default(0)
  cooldownSeconds Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model NpcDefinition {
  id                 String   @id @default(uuid())
  name               String
  role               String
  interactionType    String
  imageUrl           String?
  description        String?
  dialogue           String?
  xpReward           Int      @default(0)
  coinsReward        Int      @default(0)
  rewardItemName     String?
  rewardItemCategory String?
  rewardItemType     String?
  rewardItemImg      String?
  rewardItemEffect   String?
  rewardItemValue    Int?
  rewardItemQuantity Int      @default(1)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  startingMissions   MissionDefinition[] @relation("MissionStartNpc")
  completionMissions MissionDefinition[] @relation("MissionCompletionNpc")
}

model Transaction {
  id          String   @id @default(uuid())
  characterId String
  type        String
  value       Int
  createdAt   DateTime @default(now())

  character Character @relation(fields: [characterId], references: [id])
}

model CharacterActionLog {
  id          String    @id @default(uuid())
  characterId String
  actionType  String
  referenceId String?
  outcome     String
  availableAt DateTime?
  metadata    String?
  createdAt   DateTime  @default(now())

  character Character @relation(fields: [characterId], references: [id])

  @@index([characterId, actionType, createdAt])
  @@index([characterId, actionType, referenceId, createdAt])
}

model ShopProduct {
  id               String               @id @default(uuid())
  slug             String               @unique
  name             String
  description      String?
  category         String
  type             String
  img              String
  effect           String?
  levelRequirement Int?
  assetKind        ShopProductAssetKind
  price            Int
  currency         String               @default("BRL")
  rewardCoins      Int                  @default(0)
  rewardQuantity   Int                  @default(1)
  isActive         Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  paymentOrders PaymentOrder[]
}

model PaymentOrder {
  id                String             @id @default(uuid())
  userId            String
  characterId       String
  productId         String
  quantity          Int
  unitPrice         Int
  totalPrice        Int
  currency          String             @default("BRL")
  status            PaymentOrderStatus @default(PENDING)
  provider          String?
  providerReference String?            @unique
  providerPaymentId String?            @unique
  failureReason     String?
  paidAt            DateTime?
  fulfilledAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user      User        @relation(fields: [userId], references: [id])
  character Character   @relation(fields: [characterId], references: [id])
  product   ShopProduct @relation(fields: [productId], references: [id])
}

model RewardClaim {
  id          String   @id @default(uuid())
  characterId String
  claimKey    String   @unique
  type        String
  value       Int
  metadata    String?
  claimedAt   DateTime @default(now())

  character Character @relation(fields: [characterId], references: [id])
}

model CharacterMissionSession {
  id            String               @id @default(uuid())
  characterId   String
  missionId     String
  status        MissionSessionStatus @default(IN_PROGRESS)
  currentNodeId String
  selectedPath  String?
  metadata      Json?
  startedAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  completedAt   DateTime?

  character Character         @relation(fields: [characterId], references: [id])
  mission   MissionDefinition @relation(fields: [missionId], references: [id])
  combats   CombatSession[]

  @@index([characterId, missionId, status])
  @@index([characterId, updatedAt])
}

model CombatSession {
  id                     String              @id @default(uuid())
  characterId            String
  missionSessionId       String?
  sourceType             CombatSourceType
  sourceId               String
  status                 CombatSessionStatus @default(IN_PROGRESS)
  enemyName              String
  enemyImageUrl          String?
  enemyLevel             Int
  enemyAttack            Int
  enemyDefense           Int
  enemyCurrentHealth     Int
  enemyMaxHealth         Int
  characterCurrentHealth Int
  characterMaxHealth     Int
  turnNumber             Int                 @default(1)
  availableAt            DateTime?
  rewards                Json?
  defeatPenalty          Json?
  battleLog              Json?
  metadata               Json?
  startedAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  completedAt            DateTime?

  character      Character                @relation(fields: [characterId], references: [id])
  missionSession CharacterMissionSession? @relation(fields: [missionSessionId], references: [id])

  @@index([characterId, status, updatedAt])
  @@index([missionSessionId, status])
}

model Trade {
  id                   String      @id @default(uuid())
  requesterCharacterId String
  targetCharacterId    String
  offeredCoins         Int         @default(0)
  requestedCoins       Int         @default(0)
  status               TradeStatus @default(PENDING)
  note                 String?
  expiresAt            DateTime
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  requesterCharacter Character    @relation("TradeRequesterCharacter", fields: [requesterCharacterId], references: [id])
  targetCharacter    Character    @relation("TradeTargetCharacter", fields: [targetCharacterId], references: [id])
  assets             TradeAsset[]

  @@index([requesterCharacterId, status, createdAt])
  @@index([targetCharacterId, status, createdAt])
}

model TradeAsset {
  id        String               @id @default(uuid())
  tradeId   String
  side      TradeParticipantSide
  assetType TradeAssetType
  assetId   String
  quantity  Int                  @default(1)
  createdAt DateTime             @default(now())

  trade Trade @relation(fields: [tradeId], references: [id])

  @@index([tradeId, side])
}

model PvpMatch {
  id                     String   @id @default(uuid())
  challengerCharacterId  String
  opponentCharacterId    String
  winnerCharacterId      String
  loserCharacterId       String
  challengerRatingBefore Int
  challengerRatingAfter  Int
  opponentRatingBefore   Int
  opponentRatingAfter    Int
  createdAt              DateTime @default(now())

  challengerCharacter Character @relation("PvpMatchChallenger", fields: [challengerCharacterId], references: [id])
  opponentCharacter   Character @relation("PvpMatchOpponent", fields: [opponentCharacterId], references: [id])
  winnerCharacter     Character @relation("PvpMatchWinner", fields: [winnerCharacterId], references: [id])
  loserCharacter      Character @relation("PvpMatchLoser", fields: [loserCharacterId], references: [id])

  @@index([createdAt])
  @@index([winnerCharacterId, createdAt])
}

model Table {
  id               String      @id @default(uuid())
  masterId         String
  settingId        String
  episodeId        String
  contextVersionId String
  name             String
  description      String      @default("")
  joinCode         String      @unique
  maxPlayers       Int         @default(8)
  status           TableStatus @default(RECRUITING)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  master           User                 @relation("TableMaster", fields: [masterId], references: [id])
  setting          Setting              @relation(fields: [settingId], references: [id], onDelete: Restrict)
  episode          Episode              @relation(fields: [episodeId], references: [id], onDelete: Restrict)
  contextVersion   ContextVersion       @relation(fields: [contextVersionId], references: [id], onDelete: Restrict)
  members          TableMember[]
  invitations      TableInvitation[]
  world            TableWorld?
  characters       Character[]
  characterReviews CharacterReview[]
  characterTraits  CharacterTrait[]
  traitSuggestions CharacterTraitSuggestion[]
  missions         TableMission[]
  timelineEvents   TableTimelineEvent[]
  publicCampaign   PublicCampaign?
  playerAiSuggestions PlayerAiSuggestion[]
  aiUsageEvents        AiUsageEvent[]
  finalSurveyResponses FinalSurveyResponse[]
  analyticsEvents      AnalyticsEvent[]
  characterCardArtGenerations CharacterCardArtGeneration[]

  @@index([masterId, createdAt])
  @@index([settingId, episodeId, status, createdAt])
  @@index([contextVersionId])
}

model PublicCampaign {
  id                   String               @id @default(uuid())
  tableId              String               @unique
  slug                 String               @unique
  title                String
  description          String?
  status               PublicCampaignStatus @default(DRAFT)
  builderConfigVersion String               @default("pilot-v1")
  consentVersion       String               @default("research-pilot-v1")
  createdById          String
  updatedById          String?
  activatedAt          DateTime?
  closedAt             DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  table     Table                @relation(fields: [tableId], references: [id], onDelete: Restrict)
  createdBy User                 @relation("PublicCampaignCreator", fields: [createdById], references: [id])
  updatedBy User?                @relation("PublicCampaignUpdater", fields: [updatedById], references: [id])
  consents  ParticipantConsent[]
  finalSurveyResponses FinalSurveyResponse[]
  analyticsEvents      AnalyticsEvent[]

  @@index([status, createdAt])
}

model ParticipantConsent {
  id             String                   @id @default(uuid())
  userId         String
  campaignId     String
  consentVersion String
  status         ParticipantConsentStatus
  source         String
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  user     User           @relation("ParticipantConsentUser", fields: [userId], references: [id], onDelete: Cascade)
  campaign PublicCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([userId, campaignId, consentVersion])
  @@index([campaignId, status, createdAt])
  @@index([userId, status, createdAt])
}

model PlayerAiSuggestion {
  id                   String                   @id @default(uuid())
  userId               String
  tableId              String
  characterId          String?
  useCase              String
  targetField          String?
  builderConfigVersion String
  promptVersion        String
  fingerprint          String?
  contextVersionId     String?
  aiUsageEventId       String?
  model                String?
  suggestion           Json
  status               PlayerAiSuggestionStatus @default(GENERATED)
  decisionPayload      Json?
  appliedContentHash   String?
  decidedAt            DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  user      User       @relation("PlayerAiSuggestionUser", fields: [userId], references: [id], onDelete: Cascade)
  table     Table      @relation(fields: [tableId], references: [id], onDelete: Cascade)
  character Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  contextVersion ContextVersion? @relation(fields: [contextVersionId], references: [id], onDelete: SetNull)
  aiUsageEvent AiUsageEvent? @relation("AiUsageEventSuggestionLink", fields: [aiUsageEventId], references: [id], onDelete: SetNull)
  usageEvents AiUsageEvent[] @relation("AiUsageEventSuggestion")

  @@index([userId, tableId, status, createdAt])
  @@index([characterId, status, createdAt])
  @@index([fingerprint, createdAt])
}

model AiUsageEvent {
  id                String        @id @default(uuid())
  requestId         String        @unique
  userId            String?
  tableId           String?
  characterId       String?
  suggestionId      String?
  useCase           AiUseCase
  provider          String
  model             String
  promptVersion     String
  contextVersionId  String?
  inputTokens       Int?
  cachedInputTokens Int?
  outputTokens      Int?
  totalTokens       Int?
  imageCount        Int?
  latencyMs         Int
  status            AiUsageStatus
  errorCode         String?
  pricingVersion    String?
  costMicrosUsd     BigInt?
  costSource        AiCostSource
  createdAt         DateTime      @default(now())

  user      User?       @relation("AiUsageEventUser", fields: [userId], references: [id], onDelete: SetNull)
  table     Table?      @relation(fields: [tableId], references: [id], onDelete: SetNull)
  character Character?  @relation(fields: [characterId], references: [id], onDelete: SetNull)
  suggestion PlayerAiSuggestion? @relation("AiUsageEventSuggestion", fields: [suggestionId], references: [id], onDelete: SetNull)
  linkedSuggestions PlayerAiSuggestion[] @relation("AiUsageEventSuggestionLink")

  @@index([createdAt])
  @@index([useCase, createdAt])
  @@index([provider, model, createdAt])
  @@index([status, createdAt])
  @@index([tableId, createdAt])
  @@index([characterId, createdAt])
  @@index([suggestionId])
}

model AiPricing {
  id                         String            @id @default(uuid())
  provider                   String
  model                      String
  modality                   AiPricingModality
  inputMicrosUsdPerMillion   BigInt?
  cachedInputMicrosUsdPerMillion BigInt?
  outputMicrosUsdPerMillion  BigInt?
  imageMicrosUsd             BigInt?
  currency                   String            @default("USD")
  effectiveFrom              DateTime
  version                    String
  createdAt                  DateTime          @default(now())

  @@unique([provider, model, modality, version])
  @@index([provider, model, modality, effectiveFrom])
}

model FinalSurveyResponse {
  id            String   @id @default(uuid())
  userId        String
  campaignId    String
  tableId       String
  role          String   @default("PLAYER")
  surveyVersion String
  answers       Json
  submittedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user     User           @relation("FinalSurveyResponseUser", fields: [userId], references: [id], onDelete: Cascade)
  campaign PublicCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  table    Table          @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@unique([userId, campaignId])
  @@index([campaignId, submittedAt])
  @@index([tableId, submittedAt])
}

model AnalyticsEvent {
  id              String   @id @default(uuid())
  eventKey        String
  occurredAt      DateTime @default(now())
  userId          String?
  campaignId      String?
  tableId         String?
  characterId     String?
  sessionId       String?
  source          String?
  metadataVersion String   @default("pilot-v1")
  metadata        Json?
  createdAt       DateTime @default(now())

  user      User?           @relation("AnalyticsEventUser", fields: [userId], references: [id], onDelete: SetNull)
  campaign  PublicCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  table     Table?          @relation(fields: [tableId], references: [id], onDelete: SetNull)
  character Character?      @relation(fields: [characterId], references: [id], onDelete: SetNull)

  @@index([eventKey, occurredAt])
  @@index([campaignId, eventKey, occurredAt])
  @@index([userId, campaignId, occurredAt])
  @@index([tableId, occurredAt])
}

model TableMember {
  id       String            @id @default(uuid())
  tableId  String
  userId   String
  role     TableMemberRole   @default(PLAYER)
  status   TableMemberStatus @default(ACTIVE)
  joinedAt DateTime          @default(now())
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  table Table @relation(fields: [tableId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([tableId, userId])
  @@index([userId, status, joinedAt])
  @@index([tableId, status, role])
}

model TableInvitation {
  id           String                @id @default(uuid())
  tableId      String
  invitedEmail String
  intendedRole TableMemberRole
  tokenHash    String                @unique
  expiresAt    DateTime
  status       TableInvitationStatus @default(PENDING)
  invitedById  String
  acceptedById String?
  acceptedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime              @default(now())

  table      Table @relation(fields: [tableId], references: [id], onDelete: Cascade)
  invitedBy  User  @relation("TableInvitationInviter", fields: [invitedById], references: [id])
  acceptedBy User? @relation("TableInvitationAccepter", fields: [acceptedById], references: [id])

  @@index([tableId, status, createdAt])
  @@index([invitedEmail, status, expiresAt])
  @@index([invitedById, createdAt])
  @@index([acceptedById, acceptedAt])
}

model TableWorld {
  id                        String   @id @default(uuid())
  tableId                   String   @unique
  campaignTitle             String
  summary                   String
  tone                      String?
  rules                     Json?
  characterCreationCriteria Json?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  table Table @relation(fields: [tableId], references: [id])
}

model CharacterReview {
  id             String                @id @default(uuid())
  tableId        String
  characterId    String
  status         CharacterReviewStatus @default(PENDING)
  masterFeedback String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  table     Table     @relation(fields: [tableId], references: [id])
  character Character @relation(fields: [characterId], references: [id])

  @@unique([tableId, characterId])
  @@index([tableId, status, createdAt])
  @@index([characterId])
}

model CharacterEpisodeAnswer {
  id             String   @id @default(uuid())
  characterId    String
  questionKey    String
  promptSnapshot String?
  answer         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, questionKey])
  @@index([characterId, createdAt])
}

model CharacterSubmissionSnapshot {
  id                     String   @id @default(uuid())
  characterId            String
  sheetRevision          Int
  submittedById          String
  submittedAt            DateTime
  builderConfigVersion   String
  contextVersionId       String
  characterSnapshot      Json
  episodeAnswersSnapshot Json
  approvedAt             DateTime?
  approvedById           String?
  createdAt              DateTime @default(now())

  character  Character      @relation(fields: [characterId], references: [id], onDelete: Cascade)
  submittedBy User          @relation("CharacterSubmissionSnapshotSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  contextVersion ContextVersion @relation(fields: [contextVersionId], references: [id], onDelete: Restrict)
  approvedBy User?         @relation("CharacterSubmissionSnapshotApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  cardArtGenerations CharacterCardArtGeneration[]

  @@unique([characterId, sheetRevision])
  @@index([characterId, submittedAt])
  @@index([submittedById, submittedAt])
  @@index([contextVersionId])
  @@index([approvedById, approvedAt])
}

model CharacterCardArtGeneration {
  id                   String   @id @default(uuid())
  characterId          String
  submissionSnapshotId String
  userId               String
  tableId              String
  attemptNumber        Int
  variant              String   @default("PORTRAIT")
  briefing             String?  @db.VarChar(240)
  status               String   @default("PENDING")
  promptVersion        String
  prompt               String   @db.Text
  provider             String?
  model                String?
  mimeType             String?
  imageData            Bytes?
  aiUsageEventId       String?
  errorCode            String?
  createdAt            DateTime @default(now())
  completedAt          DateTime?

  character          Character                   @relation(fields: [characterId], references: [id], onDelete: Cascade)
  submissionSnapshot CharacterSubmissionSnapshot @relation(fields: [submissionSnapshotId], references: [id], onDelete: Cascade)
  user               User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  table              Table                       @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@unique([characterId, attemptNumber])
  @@index([characterId, variant, status])
  @@index([userId, createdAt])
  @@index([tableId, createdAt])
  @@index([submissionSnapshotId])
}

model CharacterReviewEvent {
  id                        String                @id @default(uuid())
  characterId               String
  reviewerUserId            String
  action                    CharacterReviewAction
  reason                    String?
  characterRevisionReviewed Int
  createdAt                 DateTime              @default(now())

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  reviewer  User      @relation("CharacterReviewEventReviewer", fields: [reviewerUserId], references: [id])

  @@index([characterId, createdAt])
  @@index([reviewerUserId, createdAt])
}

model CharacterLegacyAdaptation {
  id             String   @id @default(uuid())
  characterId    String   @unique
  adminUserId    String
  sourceSnapshot Json
  adaptedAt      DateTime @default(now())

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  admin     User      @relation("CharacterLegacyAdaptationAdmin", fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([adminUserId, adaptedAt])
}

model CharacterTrait {
  id          String             @id @default(uuid())
  characterId String
  tableId     String
  type        CharacterTraitType
  name        String
  description String?
  createdById String
  createdAt   DateTime           @default(now())

  character Character @relation(fields: [characterId], references: [id])
  table     Table     @relation(fields: [tableId], references: [id])
  createdBy User      @relation("CharacterTraitCreator", fields: [createdById], references: [id])

  @@index([tableId, characterId, createdAt])
  @@index([createdById])
}

model CharacterTraitSuggestion {
  id          String                         @id @default(uuid())
  tableId     String
  characterId String
  type        CharacterTraitType
  name        String
  description String?
  category    String?
  value       String?
  source      CharacterTraitSuggestionSource @default(MASTER)
  status      CharacterTraitSuggestionStatus @default(SUGGESTED)
  createdById String
  createdAt   DateTime                       @default(now())
  updatedAt   DateTime                       @updatedAt

  table     Table     @relation(fields: [tableId], references: [id])
  character Character @relation(fields: [characterId], references: [id])
  createdBy User      @relation("CharacterTraitSuggestionCreator", fields: [createdById], references: [id])

  @@index([tableId, characterId, status, createdAt])
  @@index([createdById])
}

model TableMission {
  id          String             @id @default(uuid())
  tableId     String
  title       String
  description String
  objective   String?
  isRequired  Boolean            @default(true)
  status      TableMissionStatus @default(ACTIVE)
  dueDate     DateTime?
  createdById String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  table       Table                    @relation(fields: [tableId], references: [id])
  createdBy   User                     @relation("TableMissionCreator", fields: [createdById], references: [id])
  submissions TableMissionSubmission[]

  @@index([tableId, status, createdAt])
  @@index([createdById])
}

model TableMissionSubmission {
  id          String                       @id @default(uuid())
  missionId   String
  characterId String
  userId      String
  content     String
  status      TableMissionSubmissionStatus @default(SUBMITTED)
  masterNote  String?
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt

  mission   TableMission @relation(fields: [missionId], references: [id])
  character Character    @relation(fields: [characterId], references: [id])
  user      User         @relation(fields: [userId], references: [id])

  @@index([missionId, status, createdAt])
  @@index([userId, createdAt])
  @@index([characterId, createdAt])
}

model TableTimelineEvent {
  id          String                 @id @default(uuid())
  tableId     String
  characterId String?
  title       String
  description String
  type        TableTimelineEventType
  createdById String
  createdAt   DateTime               @default(now())

  table     Table      @relation(fields: [tableId], references: [id])
  character Character? @relation(fields: [characterId], references: [id])
  createdBy User       @relation("TableTimelineEventCreator", fields: [createdById], references: [id])

  @@index([tableId, createdAt])
  @@index([characterId, createdAt])
  @@index([createdById])
}
